[Unit]
# VM A 공격 하네스 — 오케스트레이터(VM C)가 매 공격 턴 호출하는 상주 HTTP 서비스.
# 수동 터미널 기동 대신 부팅 자동 기동 + 크래시 자동 재시작.
Description=Capstone attack harness (VM A)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vm-a
WorkingDirectory=/home/vm-a/capstone
# config.yaml 은 WorkingDirectory(=~/capstone) 기준. exec_mode:true 가 여기 config 에 있어야
# 발판 파드 안에서 공격이 돈다(외부 endpoint 로 붙으면 내부 킬체인 미도달).
ExecStart=/usr/bin/python3 -m attacker.server --config config.yaml
Restart=on-failure
RestartSec=5
# 로그: journalctl -u attacker-harness -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
